generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  userId       String        @unique
  userPassword String
  userNickname String
  trip         Trip[]
  userAnimal   UserAnimal[]
  userMissions UserMission[]
}

model UserAnimal {
  id       Int    @id @default(autoincrement())
  userId   Int
  animalId Int
  count    Int    @default(0)
  tripId   Int
  animal   Animal @relation(fields: [animalId], references: [id])
  trip     Trip   @relation(fields: [tripId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@index([animalId], map: "UserAnimal_animalId_fkey")
  @@index([userId], map: "UserAnimal_userId_fkey")
  @@index([tripId], map: "UserAnimal_tripId_fkey")
}

model UserMission {
  id          Int     @id @default(autoincrement())
  userId      Int
  missionId   Int
  isCompleted Boolean @default(false)
  round       Int
  tripId      Int
  mission     Mission @relation(fields: [missionId], references: [id])
  trip        Trip    @relation(fields: [tripId], references: [id])
  user        User    @relation(fields: [userId], references: [id])

  @@index([missionId], map: "UserMission_missionId_fkey")
  @@index([userId], map: "UserMission_userId_fkey")
  @@index([tripId], map: "UserMission_tripId_fkey")
}

model Trip {
  id              Int           @id @default(autoincrement())
  departure       String
  arrival         String
  firstDay        DateTime
  lastDay         DateTime
  completeMission Int           @default(0)
  lastAnimalId    Int?
  userId          Int?
  animalId        Int?
  level           String        @default("NONE")
  animal          Animal?       @relation("AnimalTrips", fields: [animalId], references: [id])
  lastAnimal      Animal?       @relation("LastAnimalRelation", fields: [lastAnimalId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  UserAnimal      UserAnimal[]
  UserMission     UserMission[]

  @@index([animalId], map: "Trip_animalId_fkey")
  @@index([lastAnimalId], map: "Trip_lastAnimalId_fkey")
  @@index([userId], map: "Trip_userId_fkey")
}

model Mission {
  id           Int           @id @default(autoincrement())
  missionName  String
  missionIcon  String
  thumbnail    String
  description  String
  question1    String
  question2    String
  question3    String
  userMissions UserMission[]
}

model Animal {
  id                Int          @id @default(autoincrement())
  aniImage          String
  aniName           String
  aniLevel          String
  trips             Trip[]       @relation("AnimalTrips")
  lastAnimalInTrips Trip[]       @relation("LastAnimalRelation")
  userAnimals       UserAnimal[]
}

model Airport {
  id          Int    @id @default(autoincrement())
  airportName String
  country     String
  city        String
  code        String @unique
}
